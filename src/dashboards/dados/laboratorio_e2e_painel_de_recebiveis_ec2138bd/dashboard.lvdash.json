{
  "datasets": [
    {
      "name": "ds_volume_bandeira",
      "displayName": "Volume por bandeira",
      "queryLines": [
        "SELECT a.bandeira AS bandeira, SUM(f.valor) AS volume_total\n",
        "FROM dev_recebiveis.diamond.fato_recebiveis AS f\n",
        "JOIN dev_recebiveis.diamond.dim_arranjo AS a ON f.arranjo = a.arranjo\n",
        "WHERE f.status = 'REGISTRADO'\n",
        "GROUP BY a.bandeira\n",
        "ORDER BY volume_total DESC"
      ]
    },
    {
      "name": "ds_top_cedentes",
      "displayName": "Maiores cedentes",
      "queryLines": [
        "SELECT c.nome AS cedente, c.uf AS uf, COUNT(*) AS qtd, SUM(f.valor) AS valor_total\n",
        "FROM dev_recebiveis.diamond.fato_recebiveis AS f\n",
        "JOIN dev_recebiveis.diamond.dim_cedente AS c ON f.cedente_id = c.cedente_id\n",
        "GROUP BY c.nome, c.uf\n",
        "ORDER BY valor_total DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_evolucao_status",
      "displayName": "Evolução por status",
      "queryLines": [
        "SELECT date_trunc('MONTH', f.data) AS mes, f.status AS status,\n",
        "       SUM(f.valor) AS valor_total\n",
        "FROM dev_recebiveis.diamond.fato_recebiveis AS f\n",
        "GROUP BY date_trunc('MONTH', f.data), f.status\n",
        "ORDER BY mes"
      ]
    }
  ],
